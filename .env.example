# Database (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=student_report_db
MYSQL_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/student_report_db

# Legacy Google Sheets (Optional)
GOOGLE_SHEETS_KEY=your_google_sheets_key_here
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_CREDENTIALS_JSON=""

# Public base URL of your live server
PUBLIC_BASE_URL="https://your-app-name.onrender.com"

# Twilio Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
